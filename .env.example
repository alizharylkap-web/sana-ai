# Google Gemini API Key (https://aistudio.google.com/)
# Опционально для демо-режима: если не задан, работает встроенный интеллектуальный движок Sana Mentor
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Telegram Bot Token (от @BotFather)
# Если указать токен здесь или через кнопку "API / Бот" в веб-интерфейсе,
# сервер автоматически запустит живого Telegram-бота в режиме Long-Polling!
BOT_TOKEN=""

# Порт веб-платформы (по умолчанию 3000)
PORT=3000
