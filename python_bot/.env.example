# Telegram Bot Configuration (@BotFather)
BOT_TOKEN=1234567890:AAH_your_telegram_bot_token_here
# Leave BOT_WEBHOOK_URL empty for local Long-Polling mode (python -m bot.main)
BOT_WEBHOOK_URL=
WEBHOOK_PATH=/webhook/telegram
WEBHOOK_SECRET=super_secret_telegram_webhook_token_123

# Google Gemini API Configuration (https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro

# Database Configuration (PostgreSQL or automatic SQLite fallback)
POSTGRES_USER=sana_user
POSTGRES_PASSWORD=sana_secret_password
POSTGRES_DB=sana_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis Configuration (Optional — falls back to in-memory storage if unavailable)
REDIS_HOST=localhost
REDIS_PORT=6379

# Admin Telegram User IDs (comma-separated or JSON array)
ADMIN_IDS=999999999
